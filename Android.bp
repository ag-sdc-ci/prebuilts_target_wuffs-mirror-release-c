    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-Apache-2.0",
    ],
    license_text: [
        "LICENSE",
    ],
}

prebuilt_apex {
    name: "org.blisslabs.ag.wuffs.mirror.release.c",
    apex_name: "org.blisslabs.ag.wuffs.mirror.release.c",
    source_apex_name: "org.blisslabs.ag.wuffs.mirror.release.c",
    arch: {
        x86_64: {
            src: "org.blisslabs.ag.wuffs.mirror.release.c.apex",
        },
